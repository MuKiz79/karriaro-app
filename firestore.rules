rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // 2026-06-09 Security-Audit: E-Mail-basiertes Scoping (customerEmail) NUR mit
    // verifizierter E-Mail erlauben — sonst registriert ein Angreifer mit dem
    // oeffentlichen Web-Key die E-Mail eines Opfers und liest dessen Daten (H2/M2).
    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ========== USER DATA ==========

    // Users Collection - Users können nur ihr eigenes Profil lesen/schreiben
    // Admin kann alle User lesen (für Admin-Panel)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
      // Hinweis: Admin-Leseberechtigung erlaubt auch Collection-Queries
      // L3 (2026-06-09, latent): keine Feld-Whitelist auf Eigen-Update. Heute
      // unkritisch, da KEIN users-Feld zur Autorisierung gelesen wird (Admin =
      // Token-Claim). Falls je ein Entitlement-/Rollen-/Credit-Feld eingefuehrt
      // wird: NICHT ins users-Doc, sondern Token-Claim/admin-only-Doc.
    }

    // ========== ORDERS ==========

    // Orders Collection - Users lesen eigene, Mentoren lesen zugewiesene, Admins lesen/schreiben alle
    match /orders/{orderId} {
      // Lesen (get + list): User kann eigene Orders lesen, Mentor kann zugewiesene lesen, Admin kann alle lesen
      // WICHTIG: Bei list-Queries prüft Firestore ob ALLE zurückgegebenen Dokumente die Regel erfüllen
      // 2026-06-09 (H2): customerEmail-Branch verlangt jetzt VERIFIZIERTE E-Mail.
      // Sonst registriert ein Angreifer mit dem oeffentlichen Web-Key die E-Mail
      // eines Opfers und liest dessen Bestellungen (Klarname, CV-/Fragebogendaten
      // = DSGVO, Termine). Account-gebundene Orders (userId) sind unberuehrt.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.customerEmail == request.auth.token.email && emailVerified()) ||
        resource.data.assignedCoachId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // Nur Cloud Functions
      // Update: Admin kann alles ändern, User kann nur bestimmte Felder ändern
      // Mentor (assignedCoachId) kann auch appointment-Felder ändern
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.assignedCoachId == request.auth.uid) &&
        // Erlaubte Felder für Kunden/Mentoren
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appointment', 'appointmentStatus', 'appointmentDeclineReason', 'appointmentDeclinedAt',
          'customerProposals', 'customerProposalNote', 'customerProposalSubmittedAt',
          'customerDocuments',  // Kunden können eigene Dokumente hochladen
          // Fragebogen-bezogene Felder (für Smart Questionnaire Submit)
          'questionnaire', 'questionnaireSubmittedAt', 'cvStatus', 'nextStep', 'nextStepDescription', 'workflow',
          // CV Feedback & Approval Felder
          'cvFeedback', 'cvFeedbackAt', 'cvApprovedAt',
          // Quick-Check Upload
          'quickCheckDocument'
        ])
      );
      allow delete: if isAdmin();  // Nur Admin kann Orders löschen (für Testdaten)
    }

    // ========== APPOINTMENTS & AVAILABILITY ==========

    match /availability/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Nur Admin kann Verfügbarkeiten ändern
    }

    // ========== PUBLIC CONTENT ==========

    // Coaches/Mentors - Öffentlich lesbar für Marketing-Seite
    // E-Mail-Adressen werden im Frontend nicht angezeigt (nur intern für Matching verwendet)
    // Admin kann ändern, Mentor kann eigene Verfügbarkeit ändern
    match /coaches/{coachId} {
      allow read: if true;
      // Admin kann alles ändern
      allow create, delete: if isAdmin();
      // Update: Admin kann alles ändern, Mentor kann nur eigene Verfügbarkeit und userId ändern
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'userId'])
      );
    }

    // Articles - Öffentlich lesbar, Admin kann ändern
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings - Öffentlich lesbar, Admin kann ändern
    match /settings/{document} {
      // 2026-06-09 (M3): settings/vvt (internes DSGVO-Verarbeitungsverzeichnis nach
      // Art. 30 + Sub-Prozessoren/Loeschfristen) war anonym lesbar → nur noch Admin.
      // Uebrige settings-Docs (about/mentoring/portfolio/templateStatus/legal) bleiben
      // oeffentlich (Website-Content). Hinweis (L9): besser kuenftig per-Doc-Allowlist
      // ODER sensible Docs in eine eigene admin-only-Collection statt settings.
      allow read: if isAdmin() || document != 'vvt';
      allow write: if isAdmin();
    }

    // Strategy Calls - Erstellen nur mit validen Daten, Admin kann lesen/ändern
    match /strategyCalls/{callId} {
      // 2026-06-09 (H3/M4): geschlossenes Feld-Set (keine status/reviewedBy-Injection),
      // E-Mail-Grobformat, message-Groessen-Cap. Die anonyme Create bleibt (Concierge-
      // Formular ist oeffentlich) — das Mailbombing wird im onNewConciergeRequest-Trigger
      // server-seitig per Rate-Limit gedrosselt. (Frueher behauptete der Kommentar ein
      // Rule-/Trigger-Rate-Limit, das es nicht gab — I1.)
      allow create: if request.resource.data.keys().hasAll(['name', 'email'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'source', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.email.size() < 100
                    && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Waitlist - Erstellen nur mit valider Email
    match /waitlist/{entryId} {
      // 2026-06-09 (M5): geschlossenes Feld-Set + erzwungenes status=='pending'
      // (verhindert Self-Approval/Reviewer-Faelschung beim Create) + Groessen-Caps.
      // Reine Validierung — das Formular sendet exakt diese Felder.
      allow create: if request.resource.data.keys().hasAll(['email'])
                    && request.resource.data.keys().hasOnly([
                      'name', 'email', 'linkedin', 'currentRole', 'company',
                      'yearsExperience', 'reason', 'status', 'submittedAt',
                      'reviewedBy', 'reviewedAt', 'notes', 'interviewDate', 'interviewNotes'
                    ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.email.size() < 100
                    && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
                    && request.resource.data.status == 'pending';
      allow read: if isAdmin();
      // 2026-06-09 (L8): Admin-Approval-Flow war durch `if false` blockiert →
      // Admin darf jetzt aktualisieren (Status/Notizen/Interview). Reine Funktions-
      // Reparatur, Lese-/Schreibzugriff bleibt admin-only.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admin Config - Nur Admin kann lesen/schreiben
    match /config/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========== CV TEMPLATES ==========

    // CV Templates Collection - Angemeldete User können Templates lesen (für Auswahl), Admin kann schreiben
    match /cvTemplates/{templateId} {
      allow read: if isSignedIn();  // Kunden können Templates für Auswahl sehen
      allow write: if isAdmin();
    }

    // ========== CV PROJECTS ==========

    // CV Projects Collection - Admin kann alles, Kunden können eigene lesen/schreiben (Fragebogen)
    match /cvProjects/{projectId} {
      // Lesen: Admin kann alle lesen, User kann eigene lesen (per userId ODER customerEmail)
      // 2026-06-09 (M2): customerEmail-Branch verlangt jetzt VERIFIZIERTE E-Mail
      // (Lesen UND Aendern fremder CV-Daten verhindern; gleiche Mechanik wie H2).
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.customerEmail == request.auth.token.email && emailVerified())
        )
      );
      // Erstellen: Nur Admin oder System (Cloud Function)
      allow create: if isAdmin();
      // Update: Admin kann alles, User kann nur Fragebogen-bezogene Felder ändern
      // User wird identifiziert per userId ODER (verifizierter) customerEmail
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || (resource.data.customerEmail == request.auth.token.email && emailVerified())) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questionnaire', 'documents', 'updatedAt', 'status', 'mode', 'submittedAt', 'templateSelection'])
      );
      allow delete: if isAdmin();
    }

    // ========== AUDIT LOG (DSGVO Compliance) ==========

    match /auditLog/{logId} {
      // Only admin can read audit logs
      allow read: if isAdmin();
      // Only system (Cloud Functions) can write - no direct client writes
      allow write: if false;
    }

    // ========== RATE LIMITS (nur Cloud Functions) ==========

    match /rateLimits/{docId} {
      // Kein Client-Zugriff - nur Admin SDK (Cloud Functions) kann lesen/schreiben
      allow read, write: if false;
    }

    // ========== LEAD INTELLIGENCE CRM ==========

    match /leads/{leadId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /leadSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ========== INNER CIRCLE MEMBERS ==========
    // 2026-06-09 (L7): Hatte keine Rule → Catch-all-deny → Admin-Inner-Circle-CRUD
    // + Waitlist→Member-Approval warfen permission-denied (Feature still gebrochen).
    // Jetzt admin-only (CRUD). Read bewusst NICHT isSignedIn (kein Over-Expose der
    // Mitglieder-Daten); der Per-Login-Scan checkAndSetupInnerCircleMember scheitert
    // fuer Nicht-Admins weiterhin still (try/catch) — kein Login-Bruch, kein Leak.
    match /members/{memberId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ========== CATCH-ALL: DENY ==========

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
